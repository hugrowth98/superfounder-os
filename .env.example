# Copiez ce fichier en .env à la racine du GTM-OS et remplissez ce que vous avez.
# Ne renseignez que les outils que vous utilisez : OUTILS.md s'adapte.
# Ce fichier n'est jamais lu à voix haute ni copié dans un skill.

# Apify : scraping et signaux (par défaut pour presque tout)
APIFY_TOKEN=

# Unipile : votre compte LinkedIn piloté par les skills (Sales Nav, profils, posts, invitations, DM)
UNIPILE_API_KEY=
UNIPILE_DSN=https://apiXX.unipile.com:XXXXX
UNIPILE_ACCOUNT_ID=
UNIPILE_OWN_PROVIDER_ID=

# Cookies LinkedIn pour les actors Apify Sales Navigator (récupérés par connecter-outils)
LINKEDIN_LI_AT=
LINKEDIN_LI_A=
LINKEDIN_USER_AGENT=
LINKEDIN_COOKIES_FILE=

# Crustdata : recherche d'entreprises et de personnes par API (si vous ne voulez pas d'Apify)
CRUSTDATA_API_KEY=

# FullEnrich : email, vérification, téléphone
FULLENRICH_API_KEY=

# Ocean.io : lookalikes (via MCP)
OCEAN_API_KEY=

# Lemlist : envoi email, et LinkedIn si vous le choisissez (via MCP)
LEMLIST_API_KEY=

# HubSpot : CRM (token d'application privée)
HUBSPOT_ACCESS_TOKEN=

# Optionnels, pour les signaux : PredictLeads (événements d'entreprise, levées, offres, technos datées ; clé + token)
PREDICTLEADS_API_KEY=
PREDICTLEADS_API_TOKEN=
# TheirStack (offres d'emploi par techno, intent jobs + techno ; 1 crédit par résultat)
THEIRSTACK_API_KEY=

# Garde-fous d'envoi LinkedIn (par jour, bloquants)
LIMITE_INVITATIONS_JOUR=30
LIMITE_DM_JOUR=50
