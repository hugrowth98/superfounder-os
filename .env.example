# Copiez ce fichier en .env à la racine du workspace et remplissez ce que vous avez.
# Ne renseignez que les outils que vous utilisez : OUTILS.md s'adapte.
# Ce fichier n'est jamais lu à voix haute ni copié dans un skill.

# Apify : scraping et signaux (par défaut pour presque tout)
APIFY_TOKEN=

# Unipile : votre compte LinkedIn piloté par les skills (Sales Nav, profils, posts, invitations, DM)
UNIPILE_API_KEY=
UNIPILE_DSN=https://apiXX.unipile.com:XXXXX
UNIPILE_ACCOUNT_ID=
UNIPILE_OWN_PROVIDER_ID=

# Cookies LinkedIn pour les actors Apify Sales Navigator (connecter-outils, étape 9)
# Avec browser_cookie3 installé, rien à remplir : cookies et user agent sont relus dans le navigateur avant chaque run.
LINKEDIN_CHROME_ACCOUNT=
# LINKEDIN_COOKIES_AUTO=0 pour désactiver la lecture du navigateur
# Sans browser_cookie3 : export Cookie-Editor complet (chemin) + user agent exact du navigateur
LINKEDIN_COOKIES_FILE=
LINKEDIN_USER_AGENT=
# Dernier recours, jeu minimal souvent refusé par l'actor
LINKEDIN_LI_AT=
LINKEDIN_LI_A=

# Crustdata : recherche d'entreprises et de personnes par API (si vous ne voulez pas d'Apify)
CRUSTDATA_API_KEY=

# FullEnrich : email, vérification, téléphone
FULLENRICH_API_KEY=

# Ocean.io : lookalikes, recherche précise d'entreprises, décisionnaires par domaine (API, en CLI ; MCP optionnel)
OCEAN_API_KEY=

# Prospeo (optionnel) : recherche d'entreprises et de personnes par filtres exacts, emails et mobiles vérifiés (API, en CLI ; MCP optionnel)
PROSPEO_API_KEY=

# Lemlist : envoi email et lecture des réponses (API, en CLI ; MCP optionnel), LinkedIn si vous le choisissez
LEMLIST_API_KEY=

# HubSpot : CRM (token d'application privée)
HUBSPOT_ACCESS_TOKEN=

# Optionnels, pour les signaux : PredictLeads (événements d'entreprise, levées, offres, technos datées ; clé + token)
PREDICTLEADS_API_KEY=
PREDICTLEADS_API_TOKEN=
# TheirStack (offres d'emploi par techno, intent jobs + techno ; 1 crédit par résultat)
THEIRSTACK_API_KEY=

# Publora (optionnel, contenu) : programmer les posts LinkedIn depuis le skill planifier-post (compte LinkedIn connecté dans le tableau de bord Publora)
PUBLORA_API_KEY=

# Génération d'images (master infographie) : OpenAI gpt-image en premier, sinon fal.ai ; sans clé, le prompt se colle dans l'outil d'image de votre client
OPENAI_API_KEY=
FAL_KEY=

# Garde-fous d'envoi LinkedIn (par jour, bloquants)
LIMITE_INVITATIONS_JOUR=30
LIMITE_DM_JOUR=50
